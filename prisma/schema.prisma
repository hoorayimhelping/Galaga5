// Prisma schema for HCAP - LP Management Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// User model for authentication (Felix + team)
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("user") // admin, user
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  lps          LP[]
  interactions Interaction[]
  activities   Activity[]
}

// LP (Limited Partner) model for fund investor management
model LP {
  id          String   @id @default(cuid())

  // Contact Information
  firstName   String
  lastName    String
  email       String?
  phone       String?
  linkedIn    String?

  // LP Type & Organization
  lpType      String   @default("individual") // individual, family_office, institution, fund_of_funds
  organization String? // Organization name if applicable
  title       String? // Their title/role

  // Financial Details
  commitment       Float?   // Total commitment amount ($)
  capitalCalled    Float?   @default(0) // Capital called to date
  capitalDistributed Float? @default(0) // Capital distributed to date
  ownershipPercent Float?   // Ownership percentage in fund
  vintage          String?  // Year they joined (e.g., "2024")

  // Investment Preferences
  investmentFocus  String? // Their areas of interest
  ticketSize       String? // Typical investment size
  geography        String? // Geographic focus

  // LP Management fields
  status      String   @default("prospect") // prospect, contacted, interested, committed, active, inactive, exited
  priority    String   @default("medium") // low, medium, high
  tags        String? // JSON array stored as string
  notes       String?

  // Timestamps
  lastContactedAt DateTime?
  commitmentDate  DateTime? // Date they committed
  firstCallDate   DateTime? // Date of first capital call
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  createdBy      User            @relation(fields: [createdById], references: [id])
  createdById    String
  interactions   Interaction[]
  pipelineStages PipelineStage[]
  commitments    Commitment[]

  @@index([status])
  @@index([priority])
  @@index([lpType])
  @@index([lastContactedAt])
}

// Commitment tracking for capital calls and distributions
model Commitment {
  id              String   @id @default(cuid())
  type            String   // capital_call, distribution, commitment
  amount          Float
  description     String?
  dueDate         DateTime?
  paidDate        DateTime?
  status          String   @default("pending") // pending, paid, overdue

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lp              LP       @relation(fields: [lpId], references: [id], onDelete: Cascade)
  lpId            String

  @@index([lpId])
  @@index([type])
  @@index([status])
}

// Interaction model for tracking all touchpoints
model Interaction {
  id          String   @id @default(cuid())
  type        String   // email, call, meeting, linkedin, event, note
  subject     String?
  content     String?
  outcome     String?
  sentiment   String?  // positive, neutral, negative

  // Meeting specific
  meetingDate DateTime?
  duration    Int?     // minutes

  // Email specific
  emailSent   Boolean  @default(false)
  emailOpened Boolean  @default(false)
  emailReplied Boolean @default(false)
  gmailMessageId String? // Gmail message ID for syncing

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  lp          LP       @relation(fields: [lpId], references: [id], onDelete: Cascade)
  lpId        String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdById String

  @@index([lpId])
  @@index([type])
  @@index([createdAt])
  @@index([gmailMessageId])
}

// Pipeline stages for LP fundraising progress
model PipelineStage {
  id          String   @id @default(cuid())
  stage       String   // prospect, contacted, interested, meeting, diligence, committed, active
  enteredAt   DateTime @default(now())
  exitedAt    DateTime?
  isActive    Boolean  @default(true)
  notes       String?

  lp          LP       @relation(fields: [lpId], references: [id], onDelete: Cascade)
  lpId        String

  @@index([lpId])
  @@index([stage])
  @@index([isActive])
}

// Activity log for tracking all system activities
model Activity {
  id          String   @id @default(cuid())
  type        String   // contact_created, interaction_added, stage_changed, etc.
  description String
  metadata    String?  // JSON stored as string
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
  userId      String

  @@index([userId])
  @@index([createdAt])
}

// AI Guidance and Insights
model Insight {
  id          String   @id @default(cuid())
  type        String   // weekly_summary, recommendation, alert
  title       String
  content     String
  priority    String   @default("medium") // low, medium, high, urgent
  isRead      Boolean  @default(false)
  isDismissed Boolean  @default(false)

  // AI metadata
  confidence  Float?   // 0-1 score
  basedOn     String?  // What data this insight is based on

  createdAt   DateTime @default(now())

  @@index([isRead])
  @@index([isDismissed])
  @@index([createdAt])
}

// Email templates for outreach
model EmailTemplate {
  id          String   @id @default(cuid())
  name        String
  subject     String
  body        String
  category    String?  // intro, follow_up, thank_you, quarterly_update, capital_call
  variables   String?  // JSON array of variables like {{firstName}}

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// OAuth Integration tokens
model Integration {
  id            String   @id @default(cuid())
  provider      String   // gmail, outlook, google_calendar, linkedin, google_drive
  accessToken   String
  refreshToken  String?
  expiresAt     DateTime?
  scope         String?
  email         String?  // Email address connected

  userId        String   @unique

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([provider])
  @@index([userId])
}
